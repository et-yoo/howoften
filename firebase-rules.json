{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[0-9]{4}$/)",
        ".write": "$code.matches(/^[0-9]{4}$/)",
        "students": {
          "$sid": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" }
          }
        },
        "questions": {
          "$qk": {
            "text": { ".validate": "newData.isString() && newData.val().length <= 100" }
          }
        },
        "answers": {
          "$sid": {
            "$qk": {
              "e": { ".validate": "newData.isString() && newData.val().length <= 80" }
            }
          }
        }
      }
    },
    "roomIndex": {
      ".read": true,
      ".write": true
    }
  }
}
